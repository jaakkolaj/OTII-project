{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node", "jest"],
    "typeRoots": ["./node_modules/@types", "./src/types"] 
  },
  "include": ["src/**/*", "tests/**/*"],
  "ts-node": {
    "esm": true
  }
}
