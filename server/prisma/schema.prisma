// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  url       = env("DATABASE_URL")
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String      @id @default(uuid())
  email               String      @unique
  password            String
}

model JobPosting {
  id                  String      @id @default(uuid())
  title               String
  description         String
  location            String
  employmentType      String
  seniority           String
  department          String
  requirements        String
  salaryRange         String
  closingDate         String
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt

  candidates      Candidate[]
  ai_analyses     AIAnalysis[]
}

model AIAnalysis {
  id             String    @id @default(uuid())
  candidate_id   String
  job_posting_id String
  skills         Json
  years_experience Float
  education_level String    @db.VarChar(20) // none | bachelor | master | phd
  keyword_matches Json
  strengths      Json
  weaknesses     Json
  summary        String
  raw_ai_response Json
  created_at     DateTime    @default(now())

  candidate        Candidate   @relation(fields: [candidate_id], references: [id])
  job_posting      JobPosting @relation(fields: [job_posting_id], references: [id])
}

model Candidate {
  id             String                @id @default(uuid())
  job_posting_id String
  name           String
  email          String
  createdAt      DateTime              @default(now())

  job_posting    JobPosting            @relation(fields: [job_posting_id], references: [id])
  documents      ApplicationDocument[]
  ai_analyses    AIAnalysis[]
}

model ApplicationDocument {
  id                String    @id @default(uuid())
  candidate_id      String
  document_type     String    @db.VarChar(20) // CV | COVER_LETTER
  original_filename String
  file_type         String    // pdf | docx
  file_size         Int       @default(0)
  extracted_text    String    @db.Text
  created_at        DateTime  @default(now())

  candidate         Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
}

